{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "bun-types"
    ],
    "paths": {
      "agent-tui": [
        "./packages/agent-tui/src/index.ts"
      ],
      "agent-tui/*": [
        "./packages/agent-tui/src/*"
      ],
      "agent-chat": [
        "./packages/agent-chat/src/index.ts"
      ],
      "agent-chat/*": [
        "./packages/agent-chat/src/*"
      ],
      "archon": [
        "./packages/archon/src/index.ts"
      ],
      "archon/*": [
        "./packages/archon/src/*"
      ],
      "coding-agent": [
        "./packages/coding-agent/src/index.ts"
      ],
      "coding-agent/*": [
        "./packages/coding-agent/src/*"
      ],
      "conceptcode": [
        "./packages/conceptcode/src/index.ts"
      ],
      "conceptcode/*": [
        "./packages/conceptcode/src/*"
      ],
      "symphony": [
        "./packages/symphony/src/index.ts"
      ],
      "symphony/*": [
        "./packages/symphony/src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "packages/**/*.ts"
  ]
}
